{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Iruka",
  "description": "한국어 AI 캐릭터·스토리 채팅 플랫폼",
  "colors": {
    "primary": "#684652",
    "light": "#F8C9DA",
    "dark": "#F2B8CE"
  },
  "logo": {
    "light": "/images/iruka-logomark.svg",
    "dark": "/images/iruka-logomark.svg",
    "href": "https://playiruka.space"
  },
  "favicon": "/images/iruka-logomark.svg",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "시작하기",
        "pages": [
          "overview",
          "quickstart",
          "faq"
        ]
      },
      {
        "group": "이야기 즐기기",
        "pages": [
          "reading/discovery",
          "reading/modes",
          "reading/conversations",
          "reading/persona-memory"
        ]
      },
      {
        "group": "작품 만들기",
        "pages": [
          "creating/studio",
          "creating/visibility",
          "creating/worldbuilding",
          "creating/publishing"
        ]
      },
      {
        "group": "계정과 크레딧",
        "pages": [
          "account/login",
          "account/credits"
        ]
      },
      {
        "group": "기술과 방향",
        "pages": [
          "technical/architecture",
          "technical/giwa",
          "roadmap"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Iruka 열기",
      "href": "https://playiruka.space"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Iruka",
        "items": [
          {
            "label": "Iruka 앱",
            "href": "https://playiruka.space"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/README",
      "destination": "/overview"
    },
    {
      "source": "/packs/pack-information",
      "destination": "/product-transition"
    },
    {
      "source": "/policies/ip-and-listing-policy",
      "destination": "/product-transition"
    },
    {
      "source": "/product/grading-and-verification",
      "destination": "/product-transition"
    },
    {
      "source": "/product/marketplace",
      "destination": "/product-transition"
    },
    {
      "source": "/product/redemption-and-shipping",
      "destination": "/product-transition"
    },
    {
      "source": "/product/vault",
      "destination": "/product-transition"
    },
    {
      "source": "/project/how-it-works",
      "destination": "/product-transition"
    },
    {
      "source": "/project/why-fandom-collectibles",
      "destination": "/product-transition"
    },
    {
      "source": "/technical/giwa-testnet",
      "destination": "/product-transition"
    },
    {
      "source": "/technical/monad-testnet",
      "destination": "/product-transition"
    },
    {
      "source": "/technical/onchain-architecture",
      "destination": "/product-transition"
    },
    {
      "source": "/packs/pack-reveal",
      "destination": "/product-transition"
    }
  ],
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.playiruka.space",
      "robots": "index, follow"
    }
  },
  "search": {
    "prompt": "문서 검색"
  },
  "background": {
    "color": {
      "light": "#FCFAFB",
      "dark": "#FCFAFB"
    }
  }
}
