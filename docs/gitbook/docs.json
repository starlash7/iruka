{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Iruka",
  "description": "한국어 AI 캐릭터·스토리 채팅 플랫폼",
  "colors": {
    "primary": "#1677FF",
    "light": "#20C7DF",
    "dark": "#0B63F6"
  },
  "logo": {
    "light": "/images/iruka-logomark.svg",
    "dark": "/images/iruka-logomark.svg",
    "href": "https://playiruka.space"
  },
  "favicon": "/images/iruka-logomark.svg",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Iruka",
        "pages": [
          "overview"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Iruka",
      "href": "https://playiruka.space"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Iruka",
        "items": [
          {
            "label": "Website",
            "href": "https://playiruka.space"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/README",
      "destination": "/overview"
    }
  ],
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.playiruka.space",
      "robots": "index, follow"
    }
  },
  "search": {
    "prompt": "문서 검색"
  }
}
