{
  "name": "iruka",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env.local --experimental-strip-types server/dev.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts",
    "test:db": "node --experimental-strip-types --test tests/core-db.test.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@privy-io/react-auth": "^3.35.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "1.20.0"
    },
    "viem": {
      "ws": "8.21.3"
    }
  }
}
