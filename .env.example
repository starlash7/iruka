# Browser-safe identifiers; enable Google + Email and allowed localhost origin in Privy.
# Google users do not need a separately linked email or wallet.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Server-only. App ID must match browser app. ES256 public verification key from Privy.
# PEM can contain literal \n. No server secret may use the VITE_ prefix.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# Blank DATABASE_URL uses file-backed local PostgreSQL (PGlite), outside Git.
# Set DATABASE_URL only to an isolated PostgreSQL database owned by this workspace.
DATABASE_URL=
LOCAL_DATABASE_DIR=.context/local-db
API_PORT=8787

# Reserved D integration settings; not used by the current local foundation.
# No real model/embedding/chain provider is enabled by these placeholders.
GIWA_TESTNET_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_LEDGER_ANCHOR_ADDRESS=
GIWA_KEEPER_PRIVATE_KEY=
LEDGER_HASH_SALT=
