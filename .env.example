VITE_MONAD_PACK_BATCH_ADDRESS=
VITE_MONAD_RPC_URL=
# Vercel production builds validate the Monad address against public evidence.
# Use IRUKA_RELEASE_VALIDATE=1 to run the same configuration gate locally/CI.
# Custom browser RPCs require HTTPS and their exact origin in vercel.json connect-src.

# Server-only Monad deployment credentials. Never use a VITE_ prefix.
