# Browser-safe identifiers; enable Google + Email and allowed localhost origin in Privy.
# Google users do not need a separately linked email or wallet.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Server-only. App ID must match browser app. ES256 public verification key from Privy.
# PEM can contain literal \n. No server secret may use the VITE_ prefix.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# Blank DATABASE_URL uses file-backed local PostgreSQL (PGlite), outside Git.
# Set DATABASE_URL only to an isolated PostgreSQL database owned by this workspace.
DATABASE_URL=
LOCAL_DATABASE_DIR=.context/local-db
LOCAL_IMAGE_DIRECTORY=.context/studio-images
API_PORT=8787

# Opt-in local deterministic chat: 100 credits once per user, 1 per turn.
# No paid provider, no authentication bypass; rejected in production/Vercel.
LOCAL_TEST_CHAT=0

# OpenAI adapter is implemented but not mounted by this local entrypoint.
# Enabling it requires explicit safety, credit, timeout/token and cost approval.
# Background summary calls require separate runSummaries opt-in; recovery does not.
# GIWA anchoring remains deferred. No chain credentials are required.
